# Copy this file to .env and fill in ONE provider. .env is ignored by git - never commit keys.
# Only needed for the optional LLM correction layer (README section 17).

# Which provider this laptop uses: claude | gemini | openai | groq | ollama
LLM_PROVIDER=groq

# Use the key name for your provider, so a key can only ever be sent to that provider:
GROQ_API_KEY=your-groq-key-here
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=...
# (Ollama runs locally and needs no key.)

# Optional: a different model than config.py's default for that provider
# LLM_MODEL=qwen/qwen3.8-27b
